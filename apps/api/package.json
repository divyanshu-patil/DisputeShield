    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ds/agent": "workspace:*",
    "@ds/jobs": "workspace:*",
    "@ds/schemas": "workspace:*",
